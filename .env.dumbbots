# Session mode: DUMB BOTS — playerbots on, no LLM (rule-based bot AI only).
#
# Usage: docker-compose --env-file .env.dumbbots up -d
#
# The obs profile (VictoriaMetrics/VictoriaLogs/Vector/Grafana — see
# docker-compose.yml) runs in every session mode; ac-vllm stays down without
# the llm profile, so bots run on playerbots' built-in (non-LLM) AI.
COMPOSE_PROFILES=obs
AC_AI_PLAYERBOT_ENABLED=1
AC_LLM_ENABLE=0
# Emit worldserver metrics to the obs stack's VictoriaMetrics.
AC_METRIC_ENABLE=1
