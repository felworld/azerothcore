# Session mode: SOLO — no playerbots, no LLM bots.
#
# Usage: docker-compose --env-file .env.solo up -d
#
# The obs profile (VictoriaMetrics/VictoriaLogs/Vector/Grafana — see
# docker-compose.yml) runs in every session mode; ac-vllm stays down without
# the llm profile. Only ac-worldserver is recreated on a mode switch (its env
# changed); the database/authserver keep running untouched.
COMPOSE_PROFILES=obs
AC_AI_PLAYERBOT_ENABLED=0
AC_LLM_ENABLE=0
# Emit worldserver metrics to the obs stack's VictoriaMetrics.
AC_METRIC_ENABLE=1
