{
  "uid": "felworld-bot-census",
  "title": "Bot Census",
  "tags": ["felworld"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bots online",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [{ "refId": "A", "expr": "playerbots_online_value", "legendFormat": "online" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active (AI ticking)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_activity_value{state=\"active\"}", "legendFormat": "active" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In combat",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_activity_value{state=\"in_combat\"}", "legendFormat": "combat" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_activity_value{state=\"dead\"}", "legendFormat": "dead" }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Level histogram",
      "description": "Bots per level bracket, split by faction (census cadence: 5 minutes).",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bracket) (playerbots_level_value{faction=\"alliance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (bracket) (playerbots_level_value{faction=\"horde\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "bracket", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true },
            "renameByName": { "Value #A": "Alliance", "Value #B": "Horde" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 90, "lineWidth": 0 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Alliance" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Horde" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e66767" } }]
          }
        ]
      },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "By class",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 10, "w": 6, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_class_value", "legendFormat": "{{class}}", "instant": true }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "By race",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 10, "w": 6, "x": 18, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_race_value", "legendFormat": "{{race}}", "instant": true }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Engine states",
      "description": "Mutually exclusive per bot, so the stack reads as the whole population.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "noncombat" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "combat" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }]
          },
          {
            "matcher": { "id": "byName", "options": "dead" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_engine_value", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Role split",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 4, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_role_value", "legendFormat": "{{role}}", "instant": true }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Top zones (by zone id)",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, playerbots_zone_value)",
          "legendFormat": "zone {{zone_id}}",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Activity states",
      "description": "States overlap (a mounted bot can also be moving), so these are lines, not a stack. Identity via the legend table and hover.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull", "mean"],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_activity_value", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "RPG status",
      "description": "What the RPG engine has each bot doing (mutually exclusive; stacked). Identity via the legend table and hover.",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull"],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "playerbots_rpg_status_value", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Quests per hour",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accepted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "rewarded" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }]
          },
          {
            "matcher": { "id": "byName", "options": "dropped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(playerbots_quests_value[1h])",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
